{
  // This is a checked-in VSCode workspace configuration file that can be used
  // instead of directly opening the lens checkout in VSCode.
  //
  // It's an opt-in workspace configuration that contains settings for:
  //  - vscode itself
  //  - LSP settings for working correctly with the lens.git checkout
  //  - etc.
  //
  // In terms of precedence, VSCode uses the following order in which settings
  // are applied (merged together).
  //
  //  0) default settings
  //  1) user's settings
  //  2) remote machine settings
  //  3) workspace settings  (this file)
  //  4) workspace folder settings
  //
  //
  // For details, see:
  // https://code.visualstudio.com/docs/getstarted/settings#_settings-precedence


  ////////
  // VSCode Workspace Contents
  //
  // The primary checkout is folder 0 and stays first. Milestone worktrees are
  // siblings (`../lens-<topic>`); add one entry per worktree you want visible
  // and remove it when the branch merges. Keep paths relative so the workspace
  // survives a clone into a different parent directory.
  //
  // See https://code.visualstudio.com/docs/editor/workspaces for more
  // information on this section of the file.
  "folders": [
    {
      // The primary checkout, which stays on main.
      "name": "lens",
      "path": "."
    }
    // Milestone worktrees created by `git worktree add` land beside it, e.g.
    // { "name": "wt/pipeline", "path": "../lens-pipeline" },
  ],

  ////////
  // Recommended Extensions for VSCode and lens
  //
  "extensions": {
    "recommendations": [
      // The official LSP for Rust, rust-analyzer.
      "rust-lang.rust-analyzer",

      // EditorConfig, matching .editorconfig in the tree.
      "EditorConfig.EditorConfig",

      // Cargo.toml / rustfmt.toml / mise.toml.
      "tamasfe.even-better-toml",

      // The Python extensions.
      "ms-python.python",
      "charliermarsh.ruff",

      // Markdown, matching how the docs in this tree are wrapped.
      "yzhang.markdown-all-in-one",
    ],

    "unwantedRecommendations": [
      // Conflicts with ruff, which is the formatter and linter this repo uses.
      "ms-python.black-formatter",
      "ms-python.isort",
    ]
  },


  "settings": {
    ////////
    // Extra file associations (patterns to languages)
    "files.associations": {
      "*.mk": "makefile"
    },

    // Matches the default Mist code style.
    "editor.rulers": [
        100
    ],

    // Disable graph visualization of incoming/outgoing changes.
    "scm.showHistoryGraph": false,

    ////////
    // Rust
    //

    // This works around an OOM issue with the vscode extension-host's
    // implementation of file-watching.
    // see:  https://github.com/rust-lang/rust-analyzer/issues/12572
    // see:  https://github.com/microsoft/vscode/issues/153154
    "rust-analyzer.files.watcher": "server",

    // rust-analyzer must write where the Makefile writes, or a check-on-save
    // race deadlocks against a `make build` on the cargo lock — and its
    // artifacts end up outside out/, which is the only directory this repo
    // builds into.
    "rust-analyzer.cargo.targetDir": "out/.cargo/analyzer",

    // Use clippy.
    "rust-analyzer.check.command": "clippy",

    // Use nightly rustfmt: rustfmt.toml sets imports_granularity, which is
    // nightly-only, and `make fmt` runs cargo +nightly for the same reason.
    "rust-analyzer.rustfmt.overrideCommand": [
      "rustup",
      "run",
      "nightly",
      "rustfmt",
      "--config-path=${workspaceFolder}/rustfmt.toml"
    ],

    "[rust]": {
      "editor.defaultFormatter": "rust-lang.rust-analyzer",
      "editor.formatOnSave": true
    },

    ////////
    // Python
    //
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.rulers": [88]
    },

    ////////
    // Markdown
    //
    "[markdown]": {
        // Matches how the docs in this tree are wrapped.
        "editor.rulers": [
            80
        ]
    },

    ////////
    // VSCode file exclusions
    //

    // Files that are marked as hidden in the Workspace Explorer.
    "files.exclude": {
      "**/.DS_Store": true,
      "**/.git": true,
      "**/__pycache__": true,
    },
    "explorer.excludeGitIgnore": false,

    // Files that are excluded from file-watching notifications. out/ holds
    // every build artifact, so watching it is pure noise.
    "files.watcherExclude": {
      "**/.DS_Store": true,
      "**/.git": true,
      "**/__pycache__": true,
      "out/**": true,
      "target/**": true,
      "**/.venv/**": true,
    },

    // Files that are excluded from search and quick open (^P).
    "search.exclude": {
      "out/**": true,
      "target/**": true,
      "**/.venv/**": true,
    },
    "search.useIgnoreFiles": true,
    // Don't follow symlinks (into other parts of the tree)
    "search.followSymlinks": false,
  }
}
